# .dockerignore
.git
.gitignore
venv/
venv_mac/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.vscode/
.idea/
.DS_Store
installer/dist/
installer/build/
postgres_data/
epi_monitor/storage/snapshots/*
