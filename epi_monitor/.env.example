# =========================================================
# EPI Monitor - Variáveis de Ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" real (dados sensíveis).
# =========================================================

# --- Banco de Dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epi_monitor
DB_USER=postgres
DB_PASSWORD=troque_esta_senha

# --- Segurança ---
SECRET_KEY=gere_uma_chave_aleatoria_longa_aqui
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
SESSION_TIMEOUT_MIN=480

# --- Detecção YOLO ---
YOLO_MODEL_PATH=resources/models/epi_best.pt
YOLO_CONFIDENCE=0.5
YOLO_IOU=0.45
YOLO_DEVICE=auto
YOLO_IMG_SIZE=640
YOLO_FRAME_SKIP=3

# --- Câmeras ---
MAX_CAMERAS=50
CAMERA_RECONNECT_INTERVAL=5
CAMERA_CONNECTION_TIMEOUT=10
CAMERA_TARGET_FPS=10

# --- Alertas ---
ALERT_SOUND_ENABLED=true
ALERT_SOUND_FILE=resources/sounds/alarme.wav
ALERT_COOLDOWN_SEC=30
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@empresa.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_USE_TLS=true

# --- Integrações futuras (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Armazenamento ---
CLIP_DURATION_SEC=10
STORAGE_RETENTION_DAYS=90

# --- Interface ---
UI_THEME=dark
UI_GRID_COLUMNS=3

# --- Geral ---
DEBUG=false
