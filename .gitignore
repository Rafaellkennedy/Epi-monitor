# ==========================================
# EPI Monitor - .gitignore
# ==========================================

# --- Ambientes Virtuais (qualquer local) ---
venv/
venv*/
.venv/
env/
env*/
ENV/

# --- Cache do Python e Compilação (qualquer nível) ---
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
**/.pytest_cache/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Configurações Locais e Sensíveis ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Armazenamento de Evidências, Logs e Mídias ---
storage/
**/storage/snapshots/*
!**/storage/snapshots/.gitkeep
**/storage/clips/*
!**/storage/clips/.gitkeep
**/storage/logs/*
!**/storage/logs/.gitkeep

# --- Pesos do Modelo YOLO (Arquivos .pt pesados) ---
**/*.pt
*.pt
!**/resources/models/.gitkeep

# --- Compilação e Empacotamento (PyInstaller / Inno Setup) ---
installer/dist/
installer/build/
installer/output/
dist/
build/
*.exe
*.spec.bak

# --- Dados do Docker / PostgreSQL ---
postgres_data/
**/postgres_data/

# --- IDEs e Sistema Operacional ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
